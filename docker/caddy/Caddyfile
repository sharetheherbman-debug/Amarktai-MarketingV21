{
    email {$TLS_EMAIL}
    grace_period 15s
    on_demand_tls {
        ask http://amarktai-api:4000/api/v1/white-label/domains/authorize
    }
    servers {
        protocols h1 h2 h3
    }
}

(common_proxy) {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), geolocation=(), microphone=()"
        -Server
    }

    reverse_proxy amarktai-nginx:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        health_uri /ready
        health_interval 30s
        health_timeout 10s
    }

    log {
        output stdout
        format json
    }
}

{$DOMAIN} {
    import common_proxy
}

https:// {
    tls {
        on_demand
    }
    import common_proxy
}
