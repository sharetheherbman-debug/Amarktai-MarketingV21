NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_MARKETING_PUBLIC_URL=https://marketing.amarktai.co.za
CORS_ORIGIN=http://localhost:3000

POSTGRES_USER=amarktai
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=amarktai_marketing
DATABASE_URL=postgresql://amarktai:replace-with-a-strong-database-password@postgres:5432/amarktai_marketing

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ENCRYPTION_KEY=replace-with-64-hex-characters

GENX_API_KEY=
GENX_BASE_URL=https://query.genx.sh
GENX_WEBHOOK_SECRET=
GENX_WEBHOOK_URL=

# Optional Marketing Library stock providers. Openverse and Wikimedia also
# operate anonymously; Openverse credentials only increase authenticated quota.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

GENERATION_WORKER_CONCURRENCY=2
RENDER_WORKER_CONCURRENCY=1
GENX_REQUESTS_PER_MINUTE=10
