# ===========================================
# AmarktAI Marketing - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://amarktai:amarktai_secure_password@localhost:5432/amarktai_marketing
POSTGRES_USER=amarktai
POSTGRES_PASSWORD=amarktai_secure_password
POSTGRES_DB=amarktai_marketing

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key for API Keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-string

# AI Providers
GENX_API_KEY=
GENX_BASE_URL=https://api.genxrouter.com/v1

TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1

DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@marketing.amarktai.co.za

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# First Run (set to true to trigger onboarding wizard)
FIRST_RUN=true
