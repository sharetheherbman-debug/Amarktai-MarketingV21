# White-label Marketing production environment
# Copy this file to .env.production on the deployment host and replace every placeholder.
# Never commit .env.production or expose server-side secrets through the web application.

COMPOSE_PROJECT_NAME=marketing
NODE_ENV=production
DOMAIN=marketing.example.com
TLS_EMAIL=ops@example.com
APP_URL=https://marketing.example.com
API_URL=https://marketing.example.com/api
NEXT_PUBLIC_API_URL=/api
CORS_ORIGIN=https://marketing.example.com
TRUST_PROXY_HOPS=2

# Customer-facing white-label identity. These values are safe for the browser bundle.
NEXT_PUBLIC_MARKETING_BRAND_NAME="Marketing Workspace"
NEXT_PUBLIC_MARKETING_BRAND_DESCRIPTION="AI-powered marketing automation, analytics, campaign management and growth operations."
NEXT_PUBLIC_MARKETING_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_MARKETING_BRAND_LOGO_URL=/logo.svg
NEXT_PUBLIC_MARKETING_HOST_APPLICATION_NAME="Host Application"
NEXT_PUBLIC_MARKETING_BRAND_PRIMARY_COLOR=#052b57
NEXT_PUBLIC_MARKETING_BRAND_ACCENT_COLOR=#167cc1

# Set true when an existing host Nginx owns public ports 80/443 and proxies this app.
# In shared-edge mode Marketing listens only on the configured loopback HTTP port.
SHARED_HOST_NGINX=true
HTTP_PORT=8080
HOST_NGINX_CONFIG_PATH=/etc/nginx/sites-available/marketing.example.com
CHECK_PUBLIC_HTTPS=0

POSTGRES_USER=marketing
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=marketing
REDIS_PASSWORD=replace-with-a-long-random-redis-password
DATABASE_URL=postgresql://marketing:replace-with-a-long-random-database-password@postgres:5432/marketing
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ENCRYPTION_KEY=replace-with-exactly-64-hex-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# GenX is the sole remote AI provider. This key is server-side only.
GENX_API_KEY=replace-with-your-production-genx-key
GENX_BASE_URL=https://query.genx.sh
DEFAULT_TEXT_MODEL=gpt-5.6-luna
GENX_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
GENX_WEBHOOK_URL=https://marketing.example.com/api/v1/webhooks/genx
GENX_REQUESTS_PER_MINUTE=10
GENX_AGENT_TIER_ENABLED=true

# GBP Generation Credit commercial policy.
BILLING_CURRENCY=GBP
GENERATION_CREDITS_PER_GBP=100
GENX_TARGET_MARGIN_BPS=4000
GENX_RESERVATION_BUFFER_BPS=1500
GENX_PRICE_REFRESH_MINUTES=360
GENX_PRICE_MAX_AGE_MINUTES=720
GENERATION_RESERVATION_TTL_MINUTES=60

# GenX Router accounting contract and auditable currency conversion.
GENX_PROVIDER_CREDITS_PER_USD=100
GENX_PRICING_SOURCE_CURRENCY=USD
# Replace with current verified rates immediately before release acceptance.
GENX_FX_RATES_TO_GBP='{"USD":0.79,"EUR":0.86}'

# Knowledge search uses local embeddings. There is no external provider fallback.
LOCAL_EMBEDDINGS_ENABLED=true
EMBEDDING_DIMENSIONS=1536

# Public Marketing credit checkout is disabled unless deliberately enabled and accepted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email delivery. Production startup requires an explicit sender identity.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Marketing Workspace <noreply@example.com>"

# Reusable host-application connector.
# Keep these values server-side. HOST_APP_ID must be a stable lowercase slug.
APPLICATION_CONNECTOR_SIGNING_SECRET=replace-with-a-separate-long-random-signing-pepper
HOST_APP_CONNECTOR_KEY=replace-with-the-shared-64-character-host-connector-key
HOST_APP_ID=host-app
HOST_APP_NAME="Host Application"
HOST_APP_URL=https://app.example.com
APPLICATION_CONNECTOR_MAX_CLOCK_SKEW_SECONDS=300
APPLICATION_SSO_CODE_TTL_SECONDS=120

# Legacy EquiProfile aliases are optional compatibility inputs for the first host only.
# Leave them blank on new deployments. If set, they must match the generic HOST_APP_* values.
EQUIPROFILE_CONNECTOR_KEY=
EQUIPROFILE_APP_ID=
EQUIPROFILE_APP_NAME=
EQUIPROFILE_APP_URL=

# Workers are intentionally conservative. scripts/vps-deploy.sh core does not
# start them; the workers stage starts them only after direct GenX acceptance.
GENERATION_WORKER_CONCURRENCY=1
LONGFORM_STILL_WORKER_CONCURRENCY=1
RENDER_WORKER_CONCURRENCY=1
HEALTHCHECK_TIMEOUT_MS=3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Leave FIRST_RUN=false for an existing or host-provisioned workspace.
# A deliberate bootstrap requires BOTH FIRST_RUN=true and ALLOW_FIRST_RUN_BOOTSTRAP=true.
FIRST_RUN=false
ALLOW_FIRST_RUN_BOOTSTRAP=false

# VPS operational scripts.
BACKUP_DIR=/opt/marketing/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-separate-long-backup-passphrase
# DEPLOY_BRANCH is informational for operators; DEPLOY_SHA is the enforced release pin.
DEPLOY_BRANCH=release-candidate/marketing-product-2026-08-22
# Set this to the exact final reviewed SHA after every release gate is green.
DEPLOY_SHA=replace-with-reviewed-marketing-sha
