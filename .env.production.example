# EquiProfile Marketing production environment
# Copy this file to .env.production on the VPS and replace every placeholder.
# Never commit .env.production or expose these values through the web dashboard.

COMPOSE_PROJECT_NAME=equiprofile-marketing
NODE_ENV=production
DOMAIN=marketing.equiprofile.online
TLS_EMAIL=admin@equiprofile.online
APP_URL=https://marketing.equiprofile.online
API_URL=https://marketing.equiprofile.online/api
NEXT_PUBLIC_API_URL=/api
CORS_ORIGIN=https://marketing.equiprofile.online
TRUST_PROXY_HOPS=2

# This VPS already runs EquiProfile behind host Nginx on ports 80/443.
# Keep Marketing on 127.0.0.1:8080 and proxy the Marketing hostname from host Nginx.
# When false, the standalone deployment adds Caddy and owns public ports 80/443.
SHARED_HOST_NGINX=true

POSTGRES_USER=equiprofile_marketing
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=equiprofile_marketing
REDIS_PASSWORD=replace-with-a-long-random-redis-password
DATABASE_URL=postgresql://equiprofile_marketing:replace-with-a-long-random-database-password@postgres:5432/equiprofile_marketing
REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ENCRYPTION_KEY=replace-with-exactly-64-hex-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# GenX is the sole remote AI provider. This key is server-side only.
GENX_API_KEY=replace-with-your-agent-tier-production-genx-key
GENX_BASE_URL=https://query.genx.sh
DEFAULT_TEXT_MODEL=gpt-5.6-luna
GENX_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
GENX_WEBHOOK_URL=https://marketing.equiprofile.online/api/v1/webhooks/genx
GENX_REQUESTS_PER_MINUTE=10
GENX_AGENT_TIER_ENABLED=true

# GBP Generation Credit commercial policy.
# 100 Generation Credits = GBP 1.00 retail value.
BILLING_CURRENCY=GBP
GENERATION_CREDITS_PER_GBP=100
GENX_TARGET_MARGIN_BPS=4000
GENX_RESERVATION_BUFFER_BPS=1500
GENX_PRICE_REFRESH_MINUTES=360
GENX_PRICE_MAX_AGE_MINUTES=720
GENERATION_RESERVATION_TTL_MINUTES=60

# GenX catalogue pricing may be returned in another currency. Record the source
# currency and maintain an explicit conversion map to GBP. Update the rate before
# launch and whenever it materially changes; each price snapshot stores the rate
# actually used. Models with no valid conversion remain disabled.
GENX_PRICING_SOURCE_CURRENCY=USD
GENX_FX_RATES_TO_GBP={"USD":0.79,"EUR":0.86}

# Knowledge search uses the platform's local embedding service. There is no
# external AI-provider fallback.
LOCAL_EMBEDDINGS_ENABLED=true
EMBEDDING_DIMENSIONS=1536

# Required for one-time GBP Generation Credit purchases and any paid platform
# billing. Webhook signatures must be verified before credits are issued.
STRIPE_SECRET_KEY=replace-with-your-production-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-production-stripe-webhook-secret

# Email delivery for verification, password reset, campaigns and system alerts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EquiProfile Marketing <noreply@equiprofile.online>"

# Host-application connector. Use the exact same EQUIPROFILE_CONNECTOR_KEY on
# both VPS deployments. Marketing stores only a peppered SHA-256 hash in its DB.
# Generate each secret independently, for example with: openssl rand -base64 48
APPLICATION_CONNECTOR_SIGNING_SECRET=replace-with-a-separate-long-random-signing-pepper
EQUIPROFILE_CONNECTOR_KEY=replace-with-the-shared-64-character-equiprofile-connector-key
EQUIPROFILE_APP_ID=equiprofile
EQUIPROFILE_APP_NAME=EquiProfile
EQUIPROFILE_APP_URL=https://equiprofile.online
APPLICATION_CONNECTOR_MAX_CLOCK_SKEW_SECONDS=300
APPLICATION_SSO_CODE_TTL_SECONDS=120

GENERATION_WORKER_CONCURRENCY=2
RENDER_WORKER_CONCURRENCY=1
HEALTHCHECK_TIMEOUT_MS=3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FIRST_RUN=true

# Local loopback port for direct Nginx diagnostics only.
HTTP_PORT=8080

# VPS operational scripts.
BACKUP_DIR=/opt/equiprofile-marketing/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-separate-long-backup-passphrase
DEPLOY_BRANCH=phase-1/equiprofile-relaunch-genx-credits
