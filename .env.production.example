# Copy this file to .env.production on the VPS and replace every placeholder.
# Never commit .env.production.

COMPOSE_PROJECT_NAME=amarktai-marketing
NODE_ENV=production
DOMAIN=marketing.amarktai.co.za
TLS_EMAIL=admin@amarktai.co.za
APP_URL=https://marketing.amarktai.co.za
API_URL=https://marketing.amarktai.co.za/api
NEXT_PUBLIC_API_URL=/api
CORS_ORIGIN=https://marketing.amarktai.co.za
TRUST_PROXY_HOPS=2

POSTGRES_USER=amarktai
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=amarktai_marketing

REDIS_PASSWORD=replace-with-a-long-random-redis-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ENCRYPTION_KEY=replace-with-exactly-64-hex-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GENX_API_KEY=replace-with-your-production-genx-key
GENX_BASE_URL=https://query.genx.sh
GENX_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
GENX_WEBHOOK_URL=https://marketing.amarktai.co.za/api/v1/webhooks/genx
GENX_REQUESTS_PER_MINUTE=10

# Optional provider fallbacks. Leave blank to disable.
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1

# Optional email delivery. Password reset and verification emails require SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@amarktai.co.za

GENERATION_WORKER_CONCURRENCY=2
RENDER_WORKER_CONCURRENCY=1
HEALTHCHECK_TIMEOUT_MS=3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FIRST_RUN=true

# Local loopback port for direct Nginx diagnostics only.
HTTP_PORT=8080

# VPS operational scripts.
BACKUP_DIR=/opt/amarktai/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-separate-long-backup-passphrase
DEPLOY_BRANCH=development
